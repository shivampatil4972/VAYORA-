# Copy to .env to override. Every value here is also the default baked into
# docker-compose.yml, so `docker compose up` works without a .env file.

# PostgreSQL + PostGIS
POSTGRES_DB=journex
POSTGRES_USER=journex
POSTGRES_PASSWORD=journex
POSTGRES_PORT=5432

# MongoDB
MONGO_DB=journex
MONGO_PORT=27017

# Redis
REDIS_PORT=6379

# OSRM — clipped corridor extract (see infra/osrm/prepare.sh)
OSRM_PORT=5000
OSRM_PBF_URL=https://download.geofabrik.de/asia/india/western-zone-latest.osm.pbf
# west,south,east,north — covers Kolhapur to Pune with room for detours
OSRM_BBOX=73.4,16.4,74.9,18.9

# Services
CORE_API_PORT=8080
INTEL_PORT=8000
GATEWAY_PORT=3000
WEB_PORT=5173

# Browser origins allowed to call core-api, comma-separated. Change with WEB_PORT.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# An administrator created when core-api starts. Leave ADMIN_EMAIL empty to have none.
# The password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shared HS256 secret: core-api signs, gateway verifies. Change outside local dev.
# Must be at least 32 bytes; core-api refuses to start with a shorter one.
JWT_SECRET=dev-only-change-me-dev-only-change-me
